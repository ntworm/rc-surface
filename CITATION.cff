    family-names: Worm
    alias: ntworm
version: 1.0.0
date-released: 2026-09-21
license: PolyForm-Noncommercial-1.0.0
repository-code: "https://github.com/ntworm/rc-surface"
url: "https://ntworm.github.io/rc-surface/"
keywords:
