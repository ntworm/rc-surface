# dependencies
node_modules/

# Ableton Extensions SDK/CLI tarballs: licensed material, never tracked.
# Obtain them from Ableton and verify with `npm run check:vendor` (see vendor/README.md).
vendor/*.tgz
/.vendor-private/

# build artifacts
dist/
*.tsbuildinfo
coverage/
tmp/
*.tmp

# extension packages — committed to releases/ only, never at root or in worktrees
/*.ablx
/releases/*.ablx

# logs
*.log

# secrets / certs / runtime config
.env
.env.local
.certs/
.cert/
.system_generated/
cookies/
*.pem
*.key

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# misc
*.swp
*.bak

# local-only working material
/.worktrees/
/archive/
/prompts/
docs/research/
docs/marketing/
docs/blog/
PROJECT_RELEASE_REVIEW.md
# agent handoff notes: shared between agents on this machine, never published
HANDOFF-*.md

# tester kit output (generated locally by `npm run package:tester`)
/release-kits/
/.release-local/

# untracked, locally useful artifacts
/.system_generated/
/cookies/

# build output of build.ts (should not be committed even though gitignored via dist/)
*.tsbuildinfo

# screen recordings / screencasts (kept local; share via external storage)
/recordings/*.mp4
/recordings/*.mp4.mp4
/recordings/*.webm
/recordings/*.mov

# local narration scripts and voice samples
/recordings/*.wav
/recordings/TESTE/
/recordings/_build_narrated/
/recordings/gen-*.ps1


# recordings/ is local-only � nothing in this dir belongs in git
/recordings/

# untracked dev tool cloned next to this repo (separate project, not part of rc-surface)
/ablx-registry/
/scratch-storage*/

# Playwright output
test-results/
playwright-report/
